# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Port for Web App Server
PORT=3000

# Public URL where the Web App is hosted (HTTPS required for Telegram Web App)
WEBAPP_URL=https://your-domain.ngrok-free.app

# ─── REAL EMAIL SMTP CONFIGURATION (Nodemailer) ───────────────────
# To send REAL 2FA emails to actual Outlook/Student inboxes:
# Option A: Gmail SMTP (Use App Password from Google Account Settings)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password

# Option B: Outlook / Office 365 SMTP
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=your_student_id@connect.np.edu.sg
# SMTP_PASS=your_outlook_password

# Option C: SendGrid / Resend / Mailgun
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your_sendgrid_api_key
